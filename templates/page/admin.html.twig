{% extends 'layout/base.html.twig' %}

{% block title %}Admin | Twitter{% endblock %}

{% block content %}
    <h1 class="h3 mb-3">Administrator Moderation</h1>

    <div id="admin-alerts"></div>

    <div id="admin-access-denied" class="alert alert-danger" role="alert" style="display: none;">
        Access denied. Administrator role (ROLE_ADMIN) is required.
    </div>

    <div id="admin-panel" style="display: none;">
        <div class="row g-3 mb-4">
            <div class="col-4">
                <div class="card text-center">
                    <div class="card-body">
                        <div class="text-muted small">Users</div>
                        <div id="stat-users" class="h4 mb-0">0</div>
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="card text-center">
                    <div class="card-body">
                        <div class="text-muted small">Tweets</div>
                        <div id="stat-tweets" class="h4 mb-0">0</div>
                    </div>
                </div>
            </div>
            <div class="col-4">
                <div class="card text-center">
                    <div class="card-body">
                        <div class="text-muted small">Likes</div>
                        <div id="stat-likes" class="h4 mb-0">0</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Author</th>
                        <th>Content</th>
                        <th>Likes</th>
                        <th>Created</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="admin-tweets-body"></tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/alert.js') }}"></script>
    <script src="{{ asset('js/loading.js') }}"></script>
    <script src="{{ asset('js/admin.js') }}"></script>
{% endblock %}
