# Copy to .env.deploy (gitignored) and replace every CHANGE_ME value before deploying.
# For local production testing: SERVER_NAME=localhost
# For VPS with automatic Let's Encrypt HTTPS: SERVER_NAME=<VPS_IP>.sslip.io
SERVER_NAME=localhost
TRUSTED_HOSTS=^(localhost|php|.*\.sslip\.io)$
HTTP_PORT=80
HTTPS_PORT=443

APP_SECRET=CHANGE_ME_GENERATE_32_HEX_CHARS
JWT_PASSPHRASE=CHANGE_ME_STRONG_JWT_PASSPHRASE

MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
